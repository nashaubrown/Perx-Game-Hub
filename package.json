{
  "name": "perx-play",
  "version": "0.1.0",
  "private": true,
  "description": "Perx Play — games, books, and points for restaurants and cafes in the Maldives",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:socket": "SOCKET_STANDALONE=1 tsx server/index.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "start:socket": "NODE_ENV=production SOCKET_STANDALONE=1 tsx server/index.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "books:fetch": "tsx scripts/fetch-books.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "epubjs": "^0.3.93",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.7",
    "next": "^14.2.5",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "word-list": "^4.0.0"
  }
}
