generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  MERCHANT
  ADMIN
}

enum LobbyStatus {
  OPEN
  IN_GAME
  FINISHED
  CLOSED
}

enum BookFormat {
  EPUB
  PDF
}

enum RedemptionStatus {
  PENDING
  VALIDATED
  EXPIRED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  handle       String   @unique // 3-20 chars, lowercase alphanumeric + underscore
  passwordHash String
  role         Role     @default(PLAYER)
  perxUserId   String?  @unique // linked MyPerx account (set via /api/auth/myperx)
  createdAt    DateTime @default(now())

  // daily word puzzle streak
  dailyStreak   Int       @default(0)
  lastDailyDate DateTime?

  lobbiesHosted   Lobby[]              @relation("host")
  lobbyPlayers    LobbyPlayer[]
  results         GameResult[]
  points          PointsLedger[]
  readingProgress ReadingProgress[]
  readingDays     ReadingDay[]
  bookmarks       Bookmark[]
  dailyResults    DailyPuzzleResult[]
  redemptions     Redemption[]
  merchantVenues  MerchantVenue[]
  resetTokens     PasswordResetToken[]
}

model PasswordResetToken {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

// Guests join lobbies with just a nickname. If they sign up at the end of a
// game, convertedUserId links the guest's history to the new account.
model GuestSession {
  id              String   @id @default(cuid())
  nickname        String
  createdAt       DateTime @default(now())
  convertedUserId String?

  lobbyPlayers LobbyPlayer[]
  results      GameResult[]
  points       PointsLedger[]
}

model Venue {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  location       String?
  logoUrl        String?
  analyticsToken String  @unique // bearer token for /api/v1/venues/:id/analytics

  // ---- MyPerx integration: merchant-card earning from games ----
  externalMerchantId String? @unique // MyPerx merchant id this venue maps to
  playEarnEnabled    Boolean @default(true)
  earnRatePer10      Int     @default(1) // merchant-card points per 10 play points
  dailyCardCap       Int     @default(30) // max card points per customer per day at this venue
  multiplier         Float   @default(1) // merchant-funded boost (e.g. 2x Tuesday nights)
  openHour           Int? // venue-local hour 0-23; earning outside opening hours is rejected
  closeHour          Int?
  publicIp           String? // venue Wi-Fi public IP — presence signal fast-tracks confirmation

  lobbies       Lobby[]
  sessions      GameSession[]
  rewards       Reward[]
  merchants     MerchantVenue[]
  webhookConfig WebhookConfig?
  points        PointsLedger[]
  earnEvents    PlayEarnEvent[]
}

enum EarnEventStatus {
  PENDING // waiting for a same-day transaction at the venue to confirm presence
  CONFIRMED // confirmed (transaction matched or presence signal) — queued for MyPerx
  SENT // delivered to the MyPerx wallet API
  EXPIRED // no transaction by end of day — never credited
  FAILED // delivery kept failing; kept for reconciliation
}

// Outbox for merchant-card points earned by playing at a venue. Card points
// only ever credit after confirmation (anti-farming: photographing a table QR
// and playing from home earns nothing without a purchase that day).
model PlayEarnEvent {
  id           String          @id @default(cuid())
  ledgerRowId  String          @unique // Play ledger row — the idempotency key end-to-end
  userId       String
  perxUserId   String? // present once the user has linked MyPerx
  venueId      String
  venue        Venue           @relation(fields: [venueId], references: [id])
  merchantId   String? // external MyPerx merchant id (denormalized from venue)
  playPoints   Int
  cardPoints   Int
  day          String // YYYY-MM-DD in venue-local time (caps + expiry window)
  status       EarnEventStatus @default(PENDING)
  presence     String? // what confirmed it: transaction | venue_ip | manual
  attempts     Int             @default(0)
  lastError    String?
  createdAt    DateTime        @default(now())
  confirmedAt  DateTime?
  sentAt       DateTime?

  @@index([userId, venueId, day])
  @@index([status])
}

// ---- Daily News: featured slots are the sellable unit for news providers ----
model NewsProvider {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  logoUrl       String?
  feedUrl       String? // optional RSS/Atom fallback
  apiToken      String?   @unique // bearer token for the provider push API (/api/v1/news/items)
  language      String    @default("en") // en | dv (Dhivehi/Thaana is RTL)
  featured      Boolean   @default(false) // paid placement: pinned to the top with a Featured chip
  featuredUntil DateTime? // placement end date — featured expires automatically
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  items NewsItem[]
}

// ---- Interaction engine: append-only user-behavior events ----------------
// Captures what people DO in the UI (views, taps, clicks). Combined with the
// gameplay tables (sessions, results, ledger) it powers /admin/insights.
model InteractionEvent {
  id        String   @id @default(cuid())
  actorKey  String // "user:<id>" for logged-in, "sid:<anon id>" otherwise
  userId    String?
  sid       String?
  type      String // whitelisted in /api/track
  path      String?
  venueId   String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([actorKey, createdAt])
}

model NewsItem {
  id          String       @id @default(cuid())
  providerId  String
  provider    NewsProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  url         String
  imageUrl    String?
  publishedAt DateTime
  fetchedAt   DateTime     @default(now())

  @@unique([providerId, url])
  @@index([publishedAt])
}

model MerchantVenue {
  userId  String
  venueId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
}

// Static game registry, seeded. e.g. trivia, wordrush, emoji, memory, 2048, daily
model Game {
  id         String  @id // slug
  name       String
  tagline    String
  multi      Boolean
  minPlayers Int     @default(1)
  maxPlayers Int     @default(1)

  lobbies  Lobby[]
  sessions GameSession[]
}

model Lobby {
  id         String      @id @default(cuid())
  code       String      @unique // 6-char join code, unambiguous charset
  gameId     String
  game       Game        @relation(fields: [gameId], references: [id])
  hostUserId String
  host       User        @relation("host", fields: [hostUserId], references: [id])
  venueId    String?
  venue      Venue?      @relation(fields: [venueId], references: [id])
  status     LobbyStatus @default(OPEN)
  createdAt  DateTime    @default(now())

  players  LobbyPlayer[]
  sessions GameSession[]
}

model LobbyPlayer {
  id       String        @id @default(cuid())
  lobbyId  String
  lobby    Lobby         @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?         @relation(fields: [userId], references: [id])
  guestId  String?
  guest    GuestSession? @relation(fields: [guestId], references: [id])
  nickname String
  joinedAt DateTime      @default(now())

  results GameResult[]

  @@unique([lobbyId, nickname])
}

model GameSession {
  id        String    @id @default(cuid())
  gameId    String
  game      Game      @relation(fields: [gameId], references: [id])
  lobbyId   String?
  lobby     Lobby?    @relation(fields: [lobbyId], references: [id])
  venueId   String?
  venue     Venue?    @relation(fields: [venueId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  results GameResult[]
}

model GameResult {
  id            String       @id @default(cuid())
  sessionId     String
  session       GameSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lobbyPlayerId String?
  lobbyPlayer   LobbyPlayer? @relation(fields: [lobbyPlayerId], references: [id])
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  guestId       String?
  guest         GuestSession? @relation(fields: [guestId], references: [id])
  score         Int
  rank          Int
  won           Boolean      @default(false)
}

model Book {
  id          String     @id @default(cuid())
  title       String
  author      String
  genre       String
  format      BookFormat @default(EPUB)
  coverUrl    String?
  sourceUrl   String? // remote EPUB (Project Gutenberg), fetched and cached on demand
  filePath    String? // local file under storage/ once fetched or uploaded
  gutenbergId Int?       @unique
  curated     Boolean    @default(false) // curated/local flag for Maldivian authors & cafe picks
  createdAt   DateTime   @default(now())

  progress  ReadingProgress[]
  bookmarks Bookmark[]
}

model ReadingProgress {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  location   String? // epub CFI or page number
  percent    Float    @default(0)
  finished   Boolean  @default(false)
  lastReadAt DateTime @default(now())

  @@id([userId, bookId])
}

// One row per user per day — server-side reading minutes with daily caps.
model ReadingDay {
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String // YYYY-MM-DD
  minutes       Int    @default(0)
  pointsAwarded Int    @default(0)

  @@id([userId, date])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  location  String
  label     String
  createdAt DateTime @default(now())
}

// Append-only. Balance = SUM(amount). Never mutate or delete rows.
model PointsLedger {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  guestId   String?
  guest     GuestSession? @relation(fields: [guestId], references: [id])
  amount    Int // negative for redemptions
  reason    String // game_played | game_won | daily_streak | reading | redemption | signup_bonus
  refType   String? // session | book | redemption | puzzle
  refId     String?
  venueId   String?
  venue     Venue?        @relation(fields: [venueId], references: [id])
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([venueId, createdAt])
}

model DailyPuzzleResult {
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String // YYYY-MM-DD
  guesses     Json // array of guessed words
  won         Boolean @default(false)
  finished    Boolean @default(false)
  streakAfter Int     @default(0)

  @@id([userId, date])
}

model Reward {
  id          String  @id @default(cuid())
  venueId     String
  venue       Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  description String?
  costPoints  Int
  active      Boolean @default(true)

  redemptions Redemption[]
}

model Redemption {
  id          String           @id @default(cuid())
  rewardId    String
  reward      Reward           @relation(fields: [rewardId], references: [id])
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  code        String // short-lived 6-digit code staff validates
  status      RedemptionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  expiresAt   DateTime
  validatedAt DateTime?

  @@index([code, status])
}

model WebhookConfig {
  id            String  @id @default(cuid())
  venueId       String  @unique
  venue         Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  url           String
  secret        String
  enabled       Boolean @default(true)
  lastDigestDay String? // venue-local day of the last daily digest sent (idempotency)
}
