# PostgreSQL connection
DATABASE_URL="postgresql://perx:perx@localhost:5432/perx_play"
# Secret for signing JWTs (use a long random string in production)
JWT_SECRET="change-me"
# Public URL of the app (used in QR codes and reset links)
APP_URL="http://localhost:3000"
PORT=3000
# Only used when running the socket server standalone (npm run dev:socket)
SOCKET_PORT=3001
# Optional: point the frontend at a standalone socket server
# NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
